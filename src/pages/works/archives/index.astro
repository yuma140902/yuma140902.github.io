---
import Work from '../../../components/features/Work.astro';
import { old_works } from '../../../data/works';
import MdLayout from '../../../layouts/MdLayout.astro';
---

<MdLayout frontmatter={{
  title: "作っていたもの",
  create_date: "2022-11-16",
  update_date: "2024-09-10",
  og_description: "過去のプロジェクト",
  no_toc: true
}}>
  <p>過去のプロジェクト。下に行くほど古い。</p>

  <div class="works"> {old_works.map(work => <div><Work work={work} showDate/></div>)} </div>
</MdLayout>

<style>
.works > * {
  padding-bottom: 16px;
  padding-left: 4px;
  padding-right: 4px;
}
.works > *:nth-child(odd) {
  background-color: #eee;
}
</style>

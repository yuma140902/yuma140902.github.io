---
import Work from '../../components/features/Work.astro';
import { getWorks } from '../../data/works';
import MdLayout from '../../layouts/MdLayout.astro';

const works = await getWorks('main');
---

<MdLayout frontmatter={{
  title: "Works",
  create_date: "2022-11-16",
  update_date: "2024-09-10",
  og_description: "開発中のプロジェクト",
}}>
  <div class="works">
    {
    works.map((work) =>
    <div>
      <Work work={work} showDate/>
    </div>)
    }
  </div>

  <hr />

  <h2><a href="/works/archives/">その他</a></h2>

</MdLayout>

<style>
.works > * {
  padding-bottom: 16px;
}
</style>

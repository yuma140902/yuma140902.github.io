---
import { Icon } from 'astro-icon/components';
import { getSinceUntilText, type Work } from '../../data/works';
import Badge from '../Badge.astro';

interface Props {
  work: Work;
  showDate?: boolean;
  slugToLink?: string;
}

const { work, showDate, slugToLink } = Astro.props;
const dateText = showDate ? getSinceUntilText(work.since, work.until) : undefined;
---
<div class="work">
  <div class="name" style="grid-area: name">
    <h3>{work.name}</h3>
  </div>
  <div class="date" style="grid-area: date">
    { (dateText && dateText.length > 0) &&
      <span>
        <time>
          {dateText}
        </time>
      </span>
    }
  </div>
  <div class="desc" style="grid-area: desc">
    {work.description}
    {slugToLink && <>&nbsp;<a href={slugToLink} >詳細...</a></>}
  </div>
  <div class="badges" style="grid-area: badges">
    {work.technologies?.map(t =>
      <Badge t={t} />
    )}
  </div>
  <div class="repo" style="grid-area: repo">
    {work.repo &&
    <a href={work.repo} >
      <Icon name="simple-icons:github" title="GitHub" size="1.25em" class="repo-icon"/>
    </a>
    }
  </div>
</div>

<style>
.work {
  display: block grid;
  grid-template:
    "name date badges .    repo"
    "desc desc desc   desc desc"
    / 1fr auto auto 4px auto;
  align-items: center;
}
@media (max-width: 576px) {
  .work {
    grid-template:
      "name   name name   repo"
      ".      date badges badges"
      "desc   desc desc   desc"
      / 1fr auto auto auto;
  }
}
.name {
  > h3 {
    margin: 0;
    padding: 0;
  }
}
.date {
  > * {
    color: var(--color-grey);
    font-size: 12px;
  }
}
.repo {
  width: 1.25em;
  height: 1.25em;
}
.repo-icon {
  display: block;
  color: #000000;
}
</style>

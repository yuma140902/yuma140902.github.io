---
import type { App } from '../../data/apps';
import AppComponent from './App.astro';

interface Props {
  apps: App[];
}

const { apps } = Astro.props;
---

<div class="apps">
  {apps.map((app) => (
    <div>
      <AppComponent name={app.name} copy={app.copy} url={app.url} img={app.img} badge={app.badge} outside={app.outside} />
    </div>
  )) }
</div>

<style>
.apps > *:nth-child(odd) {
  background-color: #eee;
}
</style>

---
import { type Technology, getTechnologyLabel, getTechnologyColor } from '../data/technology_enum';

interface Props {
  t: Technology;
}

const { t } = Astro.props;
const [bg, fg] = getTechnologyColor(t);
const style = `background: ${bg}; color: ${fg};`;
---

<span class="badge" style={style}>{getTechnologyLabel(t)}</span>

<style>
.badge {
  padding-left: 6px;
  padding-right: 6px;
  font-size: 12px;
  border-radius: 3px;
  cursor: default;
  box-sizing: border-box;
  display: inline-block;
  height: 20px;
}
</style>
